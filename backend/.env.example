# Server Configuration
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/popenguine
MONGODB_USER=popenguine_user
MONGODB_PASSWORD=secure_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_now
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Admin Credentials (Hash with bcrypt in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$YourHashedPasswordHere

# Wave API (Senegal)
WAVE_API_KEY=your_wave_api_key_here
WAVE_API_SECRET=your_wave_api_secret_here
WAVE_API_URL=https://api.wave.com
WAVE_MERCHANT_ID=your_merchant_id_here
WAVE_WEBHOOK_SECRET=your_webhook_secret_here

# Orange Money API (Senegal)
ORANGE_API_KEY=your_orange_api_key_here
ORANGE_API_SECRET=your_orange_api_secret_here
ORANGE_API_URL=https://api.orange.com
ORANGE_MERCHANT_ID=your_merchant_id_here
ORANGE_WEBHOOK_SECRET=your_webhook_secret_here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@popenguine.com

# Frontend
FRONTEND_URL=http://localhost:8000
FRONTEND_ADMIN_URL=http://localhost:8000/admin

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Security
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payment Settings
PAYMENT_AMOUNT_FCFA=5000
CURRENCY=XOF

# Session
SESSION_SECRET=your_session_secret_key_here
SESSION_TIMEOUT=3600000

# Sentry (Error tracking) - Optional
SENTRY_DSN=

# Environment
CORS_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
